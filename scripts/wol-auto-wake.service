[Unit]
Description=Wake on LAN Auto Wake - monitoruje NPM i budzi urządzenie przy 502
After=docker.service network.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wol-auto-wake.sh
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
