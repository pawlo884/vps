---
# Przykładowy plik sekretów - skopiuj do secrets.yml i uzupełnij
# Plik secrets.yml jest w .gitignore i nie będzie commitowany

# Hasła do sieci WiFi
# Loki - priorytetowy (wyższy priorytet = wyższy priorytet)
# Thor - zapasowy (niższy priorytet)
wifi_networks:
  - ssid: "Loki"
    password: "********"  # Wpisz prawdziwe hasło
    priority: 100  # Priorytetowy - wyższy priorytet
  - ssid: "Thor"
    password: "********"  # Wpisz prawdziwe hasło
    priority: 50   # Zapasowy - niższy priorytet

# Hasła do PostgreSQL (tylko hasła - reszta konfiguracji w all.yml)
postgres_instances_secrets:
  - name: prod
    db_password: "********"  # Wpisz prawdziwe hasło
  - name: test
    db_password: "********"  # Wpisz prawdziwe hasło

# Konfiguracja backupów PostgreSQL (zawiera wrażliwe dane o strukturze)
# Wszystkie ważne bazy z kontenerów PostgreSQL
postgres_backup_instances:
  # Kontener nc-postgres-1 (produkcja)
  - name: nc_matterhorn1
    container: nc-postgres-1
    db_name: matterhorn1
    db_user: pawel
    backups_dir: /srv/backups/postgres/nc
  - name: nc_default
    container: nc-postgres-1
    db_name: default
    db_user: pawel
    backups_dir: /srv/backups/postgres/nc
  - name: nc_MPD
    container: nc-postgres-1
    db_name: MPD
    db_user: pawel
    backups_dir: /srv/backups/postgres/nc
  - name: nc_web_agent
    container: nc-postgres-1
    db_name: web_agent
    db_user: pawel
    backups_dir: /srv/backups/postgres/nc
  # Kontener nc-postgres-test (test)
  - name: test_zzz_matterhorn1
    container: nc-postgres-test
    db_name: zzz_matterhorn1
    db_user: pawel
    backups_dir: /srv/postgres/test/backups
  - name: test_zzz_default
    container: nc-postgres-test
    db_name: zzz_default
    db_user: pawel
    backups_dir: /srv/postgres/test/backups
  - name: test_zzz_MPD
    container: nc-postgres-test
    db_name: zzz_MPD
    db_user: pawel
    backups_dir: /srv/postgres/test/backups
  - name: test_default
    container: nc-postgres-test
    db_name: default
    db_user: pawel
    backups_dir: /srv/postgres/test/backups
  - name: test_zzz_web_agent
    container: nc-postgres-test
    db_name: zzz_web_agent
    db_user: pawel
    backups_dir: /srv/postgres/test/backups

# Hasła aplikacji Django
app_db_password: "********"  # Wpisz prawdziwe hasło

# Django SECRET_KEY i DATABASE_URL (nadpisują wartości z all.yml)
app_env_vars_secrets:
  SECRET_KEY: "********"  # Wygeneruj nowy klucz
  DATABASE_URL: "postgresql://appuser:********@postgres:5432/nc_prod"  # Z hasłem - używa nazwy serwisu "postgres" z docker-compose (rozwiązuje się do nc-postgres-1)

# Netdata authentication (basic auth)
monitoring_auth_user: "admin"  # Użytkownik do Netdata
monitoring_auth_password: "********"  # Hasło do Netdata (ZMIEŃ!)
