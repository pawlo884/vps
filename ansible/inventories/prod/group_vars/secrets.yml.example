---
# Przykładowy plik sekretów - skopiuj do secrets.yml i uzupełnij
# Plik secrets.yml jest w .gitignore i nie będzie commitowany

# Hasła do sieci WiFi
wifi_networks:
  - ssid: "Loki"
    password: "twoje_haslo_loki"  # Wpisz prawdziwe hasło
    priority: 100
  - ssid: "Thor"
    password: "twoje_haslo_thor"  # Wpisz prawdziwe hasło
    priority: 50

# Hasła do PostgreSQL (tylko hasła - reszta konfiguracji w all.yml)
postgres_instances_secrets:
  - name: prod
    db_password: "twoje_haslo_prod"  # Wpisz prawdziwe hasło
  - name: test
    db_password: "twoje_haslo_test"  # Wpisz prawdziwe hasło

# Konfiguracja backupów PostgreSQL (zawiera wrażliwe dane o strukturze)
postgres_backup_instances:
  - name: prod
    container: postgres_prod
    db_name: nc_prod
    db_user: appuser
    backups_dir: /srv/postgres/prod/backups
  - name: test
    container: postgres_test
    db_name: testdb
    db_user: testuser
    backups_dir: /srv/postgres/test/backups

# Hasła aplikacji Django
app_db_password: "twoje_haslo_app"  # Wpisz prawdziwe hasło

# Django SECRET_KEY i DATABASE_URL (nadpisują wartości z all.yml)
app_env_vars_secrets:
  SECRET_KEY: "wygeneruj-nowy-secret-key-dla-django"  # Wygeneruj nowy klucz
  DATABASE_URL: "postgresql://appuser:twoje_haslo_app@postgres_prod:5432/nc_prod"  # Z hasłem
