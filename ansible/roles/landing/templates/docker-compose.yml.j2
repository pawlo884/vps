---
{% if landing_use_nextjs | default(false) %}
services:
  landing:
    build:
      context: {{ landing_repo_dir_expanded | default(landing_repo_dir | default('~/landing-page') | replace('~', '/home/' + vps_user)) }}
      dockerfile: Dockerfile
    container_name: {{ landing_container_name }}
    restart: unless-stopped
    networks:
      - nginx_proxy_manager_network
    environment:
      NODE_ENV: production
      PORT: {{ landing_port | default(3000) }}
      HOSTNAME: "0.0.0.0"
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:{{ landing_port | default(3000) }}/api/health 2>/dev/null || wget --no-verbose --tries=1 --spider http://localhost:{{ landing_port | default(3000) }}/ 2>/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    logging:
      driver: "json-file"
      options:
        max-file: "3"
        max-size: "50m"
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 256M

{% else %}
services:
  landing:
    image: {{ landing_image }}
    container_name: {{ landing_container_name }}
    restart: unless-stopped
    volumes:
      - ./html:/usr/share/nginx/html:ro
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - nginx_proxy_manager_network
    healthcheck:
      test: ["CMD", "nginx", "-t"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-file: "3"
        max-size: "50m"
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 128M
        reservations:
          cpus: '0.1'
          memory: 64M
{% endif %}

networks:
  nginx_proxy_manager_network:
    name: nginx_proxy_manager_network
    external: true
