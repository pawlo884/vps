services:
  prometheus:
    image: {{ prom_image }}
    container_name: prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.retention.time=15d"
      - "--web.enable-lifecycle"
    ports:
      - "127.0.0.1:{{ prometheus_port }}:9090"
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prom-data:/prometheus
    networks:
      - {{ prom_docker_network }}
    restart: unless-stopped

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_ROOT_URL: "%(protocol)s://%(domain)s/"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
    ports:
      - "127.0.0.1:{{ grafana_port }}:3000"
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - {{ prom_docker_network }}
      - {{ prom_npm_network }}
    depends_on:
      - prometheus
    restart: unless-stopped

  node_exporter:
    image: {{ node_exporter_image }}
    container_name: node_exporter
    pid: host
    ports:
      - "127.0.0.1:{{ node_exporter_port }}:9100"
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/rootfs"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
    networks:
      - {{ prom_docker_network }}
    restart: unless-stopped

  cadvisor:
    image: {{ cadvisor_image }}
    container_name: cadvisor
    privileged: true
    devices:
      - /dev/kmsg
    ports:
      - "127.0.0.1:{{ cadvisor_port }}:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    networks:
      - {{ prom_docker_network }}
    restart: unless-stopped

{% if blackbox_http_targets | default([]) | length > 0 %}
  blackbox:
    image: {{ blackbox_image }}
    container_name: blackbox
    ports:
      - "127.0.0.1:{{ blackbox_port }}:9115"
    networks:
      - {{ prom_docker_network }}
    restart: unless-stopped
{% endif %}

{% for exp in prometheus_postgres_exporters | default([]) if exp.enabled | default(true) %}
  postgres_exporter_{{ exp.name }}:
    image: {{ postgres_exporter_image }}
    container_name: postgres_exporter_{{ exp.name }}
    ports:
      - "127.0.0.1:{{ exp.host_port }}:9187"
    networks:
      - {{ prom_docker_network }}
{% for net in exp.networks | default([]) %}
      - {{ net }}
{% endfor %}
    environment:
      DATA_SOURCE_NAME: "postgresql://{{ exp.db_user }}:{{ _prom_pg_passwords[exp.name] | urlencode }}@{{ exp.host }}:{{ exp.port | default(5432) }}/{{ exp.db_name }}?sslmode=disable"
    restart: unless-stopped
{% endfor %}

volumes:
  prom-data:
    name: observability_prom-data
  grafana-data:
    name: observability_grafana-data

networks:
  {{ prom_docker_network }}:
    name: {{ prom_docker_network }}
    external: true
  {{ prom_npm_network }}:
    name: {{ prom_npm_network }}
    external: true
{% for net in _prom_external_networks | default([]) %}
  {{ net }}:
    name: {{ net }}
    external: true
{% endfor %}


