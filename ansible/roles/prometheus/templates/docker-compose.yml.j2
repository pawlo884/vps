version: "3.8"
services:
  prometheus:
    image: {{ prom_image }}
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.retention.time=15d"
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:{{ prometheus_port }}:9090"
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prom-data:/prometheus
    networks:
      - {{ prom_docker_network }}
    restart: unless-stopped

  grafana:
    image: {{ grafana_image }}
    environment:
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_USERS_ALLOW_SIGN_UP=false
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:{{ grafana_port }}:3000"
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - {{ prom_docker_network }}
    restart: unless-stopped

  node_exporter:
    image: {{ node_exporter_image }}
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:{{ node_exporter_port }}:9100"
    networks:
      - {{ prom_docker_network }}
    command:
      - "--collector.processes"
      - "--collector.systemd"
    restart: unless-stopped

  cadvisor:
    image: {{ cadvisor_image }}
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:{{ cadvisor_port }}:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    networks:
      - {{ prom_docker_network }}
    restart: unless-stopped

  blackbox:
    image: {{ blackbox_image }}
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:{{ blackbox_port }}:9115"
    networks:
      - {{ prom_docker_network }}
    restart: unless-stopped

  postgres_exporter_shared:
    image: {{ postgres_exporter_image }}
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:9187:9187"
    networks:
      - {{ prom_docker_network }}
      - {{ postgres_network | default('dbnet') }}
    environment:
      DATA_SOURCE_NAME: "postgresql://shareduser:{{ postgres_instances_secrets | selectattr('name', 'equalto', 'shared') | map(attribute='db_password') | first | default('') }}@postgres_shared:5432/shared?sslmode=disable"
    restart: unless-stopped

  postgres_exporter_nc:
    image: {{ postgres_exporter_image }}
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:9188:9187"
    networks:
      - {{ prom_docker_network }}
      - {{ postgres_network | default('dbnet') }}
      - nc_nc_network
    environment:
      DATA_SOURCE_NAME: "postgresql://pawel:{{ app_db_password }}@nc-postgres-1:5432/postgres?sslmode=disable"
    restart: unless-stopped

volumes:
  prom-data:
  grafana-data:

networks:
  {{ prom_docker_network }}:
    external: true
  {{ postgres_network | default('dbnet') }}:
    external: true
  nc_nc_network:
    external: true


