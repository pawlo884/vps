# PostgreSQL Configuration for Test Container
# Optymalizacje dla rozwiązania problemu lagu w pierwszym połączeniu

# ============================================================================
# TCP Keepalive settings (KRYTYCZNE - rozwiązuje problem wolnych połączeń)
# Zoptymalizowane dla sieci lokalnej WiFi (lokalny PC -> VPS w tej samej sieci)
# WiFi routery często zamykają nieaktywne połączenia, więc wartości są agresywne
# ============================================================================
tcp_keepalives_idle = 15          # 15s - WiFi routery zamykają połączenia szybciej
tcp_keepalives_interval = 3      # 3s - szybka reakcja na problemy
tcp_keepalives_count = 3         # 3 próby przed timeoutem
statement_timeout = 30000         # Timeout zapytania (30 sekund w ms)

# ============================================================================
# Network settings
# ============================================================================
listen_addresses = '*'

# ============================================================================
# Memory settings (dostosowane do testowego środowiska)
# ============================================================================
shared_buffers = 256MB
effective_cache_size = 1GB
work_mem = 4MB
maintenance_work_mem = 64MB

# ============================================================================
# SSD optimizations
# ============================================================================
random_page_cost = 1.1
effective_io_concurrency = 200

# ============================================================================
# WAL settings
# ============================================================================
wal_level = replica
max_wal_size = 1GB
checkpoint_timeout = 10min
min_wal_size = 80MB

# ============================================================================
# Connection settings
# ============================================================================
max_connections = 100
idle_in_transaction_session_timeout = 60000

# ============================================================================
# Logging (kontrolowane przez Docker logging driver)
# ============================================================================
log_destination = 'stderr'
logging_collector = off

# ============================================================================
# Query tuning
# ============================================================================
default_statistics_target = 100

# ============================================================================
# Locale and formatting
# ============================================================================
datestyle = 'iso, mdy'
timezone = 'Europe/Warsaw'
lc_messages = 'en_US.utf8'
lc_monetary = 'en_US.utf8'
lc_numeric = 'en_US.utf8'
lc_time = 'en_US.utf8'
default_text_search_config = 'pg_catalog.english'




