---
services:
  postgres-test:
    image: {{ postgres_test_image | default('postgres:18.1-alpine') }}
    container_name: {{ postgres_test_container_name | default('nc-postgres-test') }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ postgres_test_user | default('testuser') }}
      POSTGRES_PASSWORD: {{ postgres_test_password }}
      POSTGRES_DB: {{ postgres_test_db | default('testdb') }}
      TZ: Europe/Warsaw
      PGDATA: /var/lib/postgresql/data/18/docker
    command:
      - postgres
      - -c
      - config_file=/etc/postgresql/postgresql.conf
      - -c
      - shared_buffers=256MB
      - -c
      - effective_cache_size=1GB
      - -c
      - work_mem=4MB
      - -c
      - maintenance_work_mem=64MB
      - -c
      - random_page_cost=1.1
      - -c
      - effective_io_concurrency=200
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_test_user | default('testuser') }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:{{ postgres_test_port | default('5433:5432') }}"
    volumes:
      - {{ postgres_test_volume | default('nc_postgres_test_data') }}:/var/lib/postgresql/data
      - ./postgresql.conf:/etc/postgresql/postgresql.conf:ro
    networks:
      - {{ postgres_test_network | default('test_network') }}
    logging:
      driver: "json-file"
      options:
        max-file: "3"
        max-size: "50m"
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 512M

volumes:
  {{ postgres_test_volume | default('nc_postgres_test_data') }}:
    external: true

networks:
  {{ postgres_test_network | default('test_network') }}:
    driver: bridge

