---
services:
  qdrant:
    image: {{ qdrant_image }}
    container_name: {{ qdrant_container_name }}
    restart: unless-stopped
    ports:
      - "{{ qdrant_port }}:6333"
      - "{{ qdrant_grpc_port }}:6334"
    volumes:
      - "{{ qdrant_data_dir }}:/qdrant/storage"
    networks:
      - {{ qdrant_network }}
    environment:
      QDRANT__SERVICE__HTTP_PORT: 6333
      QDRANT__SERVICE__GRPC_PORT: 6334
{% if qdrant_api_key is defined and qdrant_api_key != "" %}
      QDRANT__SERVICE__API_KEY: "{{ qdrant_api_key }}"
{% endif %}
{% if qdrant_log_level is defined and qdrant_log_level != "" %}
      QDRANT__LOG_LEVEL: "{{ qdrant_log_level }}"
{% endif %}
{% if qdrant_max_request_size_mb is defined and qdrant_max_request_size_mb != "" %}
      QDRANT__SERVICE__MAX_REQUEST_SIZE_MB: "{{ qdrant_max_request_size_mb }}"
{% endif %}
{% if qdrant_telemetry_disabled is defined and qdrant_telemetry_disabled %}
      QDRANT__TELEMETRY_DISABLED: "true"
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "ls /proc/*/comm 2>/dev/null | xargs grep -l qdrant 2>/dev/null | head -1 | grep -q . && exit 0 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  {{ qdrant_network }}:
    name: "{{ qdrant_network }}"
    external: true

