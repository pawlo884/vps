services:
  herd:
    build:
      context: ./src
      dockerfile: apps/herd/Dockerfile
    image: {{ herd_image }}
    container_name: {{ herd_container_name }}
    restart: unless-stopped
    env_file:
      - herd.env
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:{{ herd_external_port }}:{{ herd_internal_port }}"
    volumes:
      - "{{ herd_data_dir }}:/data/.herd"
    # Jedna instancja na volume; czas na flush SQLite i zdjęcie .store-writer.lock
    stop_grace_period: 30s
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:{{ herd_internal_port }}/api/health >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    networks:
      - {{ herd_network }}

networks:
  {{ herd_network }}:
    name: "{{ herd_network }}"
    external: true
