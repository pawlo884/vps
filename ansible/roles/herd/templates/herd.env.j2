# {{ ansible_managed }}
HERD_DATA_DIR=/data/.herd
PORT={{ herd_internal_port }}
HERD_PROVIDER_EXECUTION_MODE={{ herd_provider_execution_mode }}
HERD_ALLOWED_ORIGINS={{ herd_public_url }}
# Używany tylko przy pierwszym starcie na pustym keystore. Po onboardingu
# (stały klucz admina utworzony, bootstrap odwołany) może zostać — nie odtworzy się.
HERD_BOOTSTRAP_MASTER_KEY={{ herd_bootstrap_master_key }}
{% for key, value in (herd_env_extra | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
