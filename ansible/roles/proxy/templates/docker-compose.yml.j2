---
services:
  caddy:
    image: {{ proxy_image }}
    container_name: caddy
    restart: unless-stopped
    ports:
      - "{{ proxy_http_port }}:80"
      - "{{ proxy_https_port }}:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - {{ proxy_network }}
    healthcheck:
      test: ["CMD-SHELL", "timeout 1 bash -c '</dev/tcp/localhost/80' || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-file: "3"
        max-size: "50m"
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 256M
        reservations:
          cpus: '0.1'
          memory: 64M

networks:
  {{ proxy_network }}:
    name: {{ proxy_network }}

volumes:
  caddy_data:
  caddy_config:

