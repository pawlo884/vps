---
services:
  static-init:
    build:
      context: {{ app_dir }}
      dockerfile: {{ app_dockerfile_path }}
    image: {{ app_docker_image }}
    command:
      - /bin/bash
      - -c
      - >
        echo 'Zbieranie plików statycznych...' &&
        python manage.py collectstatic --noinput --clear --verbosity 1 &&
        echo 'Pliki statyczne zebrane'
    volumes:
      - static_volume:/app/staticfiles
    env_file:
      - {{ app_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: {{ app_django_settings | default('nc.settings.prod') }}
      TZ: {{ app_timezone | default('Europe/Warsaw') }}
      DJANGO_ENV: {{ app_environment | default('prod') }}
    networks:
      - {{ app_docker_network }}
    user: "{{ app_user_uid | default('1001:1001') }}"

  postgres:
    image: {{ app_postgres_image | default('postgres:18-alpine') }}
    restart: unless-stopped
    env_file:
      - {{ app_env_file }}
    environment:
      POSTGRES_USER: {{ app_db_user }}
      POSTGRES_PASSWORD: {{ app_db_password }}
      POSTGRES_DB: {{ app_db_name }}
      TZ: {{ app_timezone | default('Europe/Warsaw') }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ app_db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    ports:
      - "{{ app_db_expose_port | default('5432') }}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - {{ app_dir }}/docker/postgres/initdb.d:/docker-entrypoint-initdb.d:ro
    networks:
      - {{ app_docker_network }}

  web:
    build:
      context: {{ app_dir }}
      dockerfile: {{ app_dockerfile_path }}
    image: {{ app_docker_image }}
    command:
      - /bin/bash
      - -c
      - >
        gunicorn nc.wsgi:application --bind 0.0.0.0:{{ app_port }} --workers 2 --worker-class sync --timeout 300
    ports:
      - "{{ app_expose_port }}:{{ app_port }}"
    volumes:
      - {{ app_dir }}:/app
      - static_volume:/app/staticfiles
      - media_volume:/app/media
    env_file:
      - {{ app_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: {{ app_django_settings | default('nc.settings.prod') }}
      TZ: {{ app_timezone | default('Europe/Warsaw') }}
      DJANGO_ENV: {{ app_environment | default('prod') }}
      AWS_ACCESS_KEY_ID: {{ app_minio_access_key | default('${MINIO_ROOT_USER}') }}
      AWS_SECRET_ACCESS_KEY: {{ app_minio_secret_key | default('${MINIO_ROOT_PASSWORD}') }}
      AWS_STORAGE_BUCKET_NAME: {{ app_minio_bucket | default('${S3_BUCKET_NAME}') }}
      AWS_S3_ENDPOINT_URL: {{ app_minio_endpoint | default('http://minio:9000') }}
      AWS_S3_REGION_NAME: {{ app_minio_region | default('us-east-1') }}
      AWS_S3_ADDRESSING_STYLE: {{ app_minio_addressing | default('path') }}
      AWS_S3_VERIFY: {{ app_minio_verify | default('false') }}
    restart: always
    networks:
      - {{ app_docker_network }}
{% if app_docker_network != 'dbnet' %}
      - dbnet  # Sieć Qdrant dla komunikacji z bazą wektorową
{% endif %}
    depends_on:
      - postgres
      - redis
      - static-init
    user: "{{ app_user_uid | default('1001:1001') }}"

  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ app_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf
      - static_volume:/app/staticfiles
      - nginx_logs:/var/log/nginx
    environment:
      TZ: {{ app_timezone | default('Europe/Warsaw') }}
    depends_on:
      - web
      - static-init
    restart: always
    networks:
      - {{ app_docker_network }}

  celery-default:
    build:
      context: {{ app_dir }}
      dockerfile: {{ app_dockerfile_path }}
    image: {{ app_docker_image }}
    command:
      - /bin/bash
      - -c
      - >
        sleep 20 &&
        celery -A nc.celery worker -Q default --loglevel=info --concurrency=1 --max-memory-per-child=150000 --without-gossip --without-mingle --without-heartbeat
    volumes:
      - {{ app_dir }}:/app
      - celery_data:/var/lib/celery
    env_file:
      - {{ app_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: {{ app_django_settings | default('nc.settings.prod') }}
      CELERY_STATE_DB: /var/lib/celery/worker_state_default
      TZ: {{ app_timezone | default('Europe/Warsaw') }}
      CELERY_BROKER_URL: {{ app_celery_broker | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
      CELERY_RESULT_BACKEND: {{ app_celery_backend | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
      CELERY_WORKER_ENABLE_REMOTE_CONTROL: "true"
      CELERY_WORKER_SEND_TASK_EVENTS: "true"
      CELERY_TASK_SEND_SENT_EVENT: "true"
      AWS_ACCESS_KEY_ID: {{ app_minio_access_key | default('${MINIO_ROOT_USER}') }}
      AWS_SECRET_ACCESS_KEY: {{ app_minio_secret_key | default('${MINIO_ROOT_PASSWORD}') }}
      AWS_STORAGE_BUCKET_NAME: {{ app_minio_bucket | default('${S3_BUCKET_NAME}') }}
      AWS_S3_ENDPOINT_URL: {{ app_minio_endpoint | default('http://minio:9000') }}
      AWS_S3_REGION_NAME: {{ app_minio_region | default('us-east-1') }}
      AWS_S3_ADDRESSING_STYLE: {{ app_minio_addressing | default('path') }}
      AWS_S3_VERIFY: {{ app_minio_verify | default('false') }}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      web:
        condition: service_started
    restart: always
    networks:
      - {{ app_docker_network }}
    user: "{{ app_user_uid | default('1001:1001') }}"

  celery-import:
    build:
      context: {{ app_dir }}
      dockerfile: {{ app_dockerfile_path }}
    image: {{ app_docker_image }}
    command:
      - /bin/bash
      - -c
      - >
        sleep 20 &&
        celery -A nc.celery worker -Q import --loglevel=info --concurrency=1 --max-memory-per-child=150000 --without-gossip --without-mingle --without-heartbeat
    volumes:
      - {{ app_dir }}:/app
      - celery_data:/var/lib/celery
    env_file:
      - {{ app_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: {{ app_django_settings | default('nc.settings.prod') }}
      CELERY_STATE_DB: /var/lib/celery/worker_state_import
      TZ: {{ app_timezone | default('Europe/Warsaw') }}
      CELERY_BROKER_URL: {{ app_celery_broker | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
      CELERY_RESULT_BACKEND: {{ app_celery_backend | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
      CELERY_WORKER_ENABLE_REMOTE_CONTROL: "true"
      CELERY_WORKER_SEND_TASK_EVENTS: "true"
      CELERY_TASK_SEND_SENT_EVENT: "true"
      AWS_ACCESS_KEY_ID: {{ app_minio_access_key | default('${MINIO_ROOT_USER}') }}
      AWS_SECRET_ACCESS_KEY: {{ app_minio_secret_key | default('${MINIO_ROOT_PASSWORD}') }}
      AWS_STORAGE_BUCKET_NAME: {{ app_minio_bucket | default('${S3_BUCKET_NAME}') }}
      AWS_S3_ENDPOINT_URL: {{ app_minio_endpoint | default('http://minio:9000') }}
      AWS_S3_REGION_NAME: {{ app_minio_region | default('us-east-1') }}
      AWS_S3_ADDRESSING_STYLE: {{ app_minio_addressing | default('path') }}
      AWS_S3_VERIFY: {{ app_minio_verify | default('false') }}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      web:
        condition: service_started
    restart: always
    networks:
      - {{ app_docker_network }}
    user: "{{ app_user_uid | default('1001:1001') }}"

  celery-beat:
    build:
      context: {{ app_dir }}
      dockerfile: {{ app_dockerfile_path }}
    image: {{ app_docker_image }}
    command:
      - /bin/bash
      - -c
      - >
        sleep 20 &&
        celery -A nc.celery beat --loglevel=info
    volumes:
      - {{ app_dir }}:/app
    env_file:
      - {{ app_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: {{ app_django_settings | default('nc.settings.prod') }}
      TZ: {{ app_timezone | default('Europe/Warsaw') }}
      CELERY_BROKER_URL: {{ app_celery_broker | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
      CELERY_RESULT_BACKEND: {{ app_celery_backend | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
      CELERY_WORKER_ENABLE_REMOTE_CONTROL: "true"
      CELERY_WORKER_SEND_TASK_EVENTS: "true"
      CELERY_TASK_SEND_SENT_EVENT: "true"
      AWS_ACCESS_KEY_ID: {{ app_minio_access_key | default('${MINIO_ROOT_USER}') }}
      AWS_SECRET_ACCESS_KEY: {{ app_minio_secret_key | default('${MINIO_ROOT_PASSWORD}') }}
      AWS_STORAGE_BUCKET_NAME: {{ app_minio_bucket | default('${S3_BUCKET_NAME}') }}
      AWS_S3_ENDPOINT_URL: {{ app_minio_endpoint | default('http://minio:9000') }}
      AWS_S3_REGION_NAME: {{ app_minio_region | default('us-east-1') }}
      AWS_S3_ADDRESSING_STYLE: {{ app_minio_addressing | default('path') }}
      AWS_S3_VERIFY: {{ app_minio_verify | default('false') }}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      web:
        condition: service_started
    restart: always
    networks:
      - {{ app_docker_network }}
    user: "{{ app_user_uid | default('1001:1001') }}"

  redis:
    image: redis:7.2-alpine
    command: redis-server /usr/local/etc/redis/redis.conf --requirepass {{ app_redis_password | default('${REDIS_PASSWORD}') }}
    volumes:
      - redis_data:/data
      - {{ app_dir }}/redis.conf:/usr/local/etc/redis/redis.conf:ro
    networks:
      - {{ app_docker_network }}
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "{{ app_redis_password | default('${REDIS_PASSWORD}') }}", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 10s
    restart: unless-stopped

  flower:
    build:
      context: {{ app_dir }}
      dockerfile: {{ app_dockerfile_path }}
    image: {{ app_docker_image }}
    command:
      - /bin/bash
      - -c
      - >
        sleep 20 &&
        celery -A nc.celery --broker={{ app_celery_broker | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
        flower --port=5555 --basic_auth={{ app_flower_basic_auth | default('${FLOWER_USER}:${FLOWER_PASSWORD}') }}
        --persistent=True --db=/var/lib/flower/flower.db --inspect_timeout=30 --broker_api={{ app_celery_broker | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
    ports:
      - "5555:5555"
    volumes:
      - {{ app_dir }}:/app
      - flower_data:/var/lib/flower
    env_file:
      - .env
    environment:
      DJANGO_SETTINGS_MODULE: {{ app_django_settings | default('nc.settings.prod') }}
      TZ: {{ app_timezone | default('Europe/Warsaw') }}
      CELERY_BROKER_URL: {{ app_celery_broker | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
      CELERY_RESULT_BACKEND: {{ app_celery_backend | default('redis://:${REDIS_PASSWORD}@redis:6379/0') }}
      CELERY_WORKER_ENABLE_REMOTE_CONTROL: "true"
      CELERY_WORKER_SEND_TASK_EVENTS: "true"
      CELERY_TASK_SEND_SENT_EVENT: "true"
      AWS_ACCESS_KEY_ID: {{ app_minio_access_key | default('${MINIO_ROOT_USER}') }}
      AWS_SECRET_ACCESS_KEY: {{ app_minio_secret_key | default('${MINIO_ROOT_PASSWORD}') }}
      AWS_STORAGE_BUCKET_NAME: {{ app_minio_bucket | default('${S3_BUCKET_NAME}') }}
      AWS_S3_ENDPOINT_URL: {{ app_minio_endpoint | default('http://minio:9000') }}
      AWS_S3_REGION_NAME: {{ app_minio_region | default('us-east-1') }}
      AWS_S3_ADDRESSING_STYLE: {{ app_minio_addressing | default('path') }}
      AWS_S3_VERIFY: {{ app_minio_verify | default('false') }}
    depends_on:
      - postgres
      - redis
      - celery-default
      - celery-import
    networks:
      - {{ app_docker_network }}
    user: "{{ app_user_uid | default('1001:1001') }}"

volumes:
  redis_data:
  static_volume:
  media_volume:
  postgres_data:
  celery_data:
  nginx_logs:
  flower_data:

networks:
  {{ app_docker_network }}:
    driver: bridge
{% if app_docker_network != 'dbnet' %}
  dbnet:
    name: dbnet
    external: true
{% endif %}

