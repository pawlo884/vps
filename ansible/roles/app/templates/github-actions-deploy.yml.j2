name: Deploy to VPS

on:
  push:
    branches: [ main ]
  workflow_dispatch:  # Pozwala na ręczne uruchomienie

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
    
    - name: Deploy to VPS via SSH
      uses: appleboy/ssh-action@master
      with:
        host: ${{ secrets.VPS_HOST }}
        username: ${{ secrets.VPS_USER }}
        key: ${{ secrets.VPS_SSH_KEY }}
        port: 22
        debug: true
        command_timeout: 20m
        script: |
          echo "🚀 Starting deployment..."
          
          # Przejdź do katalogu aplikacji
          cd {{ app_dir }}
          
          # Aktualizuj kod
          echo "📥 Pulling latest code..."
          git fetch origin
          git reset --hard origin/main
          
          # Przejdź do katalogu docker-compose
          cd {{ app_compose_dir }}
          
          # Uruchom deploy przez docker compose
          echo "🐳 Rebuilding and restarting containers..."
          docker compose pull || true
          docker compose build --no-cache
          docker compose up -d --force-recreate
          
          # Czekaj aż kontener się uruchomi
          echo "⏳ Waiting for container to be ready..."
          sleep 10
          
          # Sprawdź status
          echo "📊 Container status:"
          docker ps | grep {{ app_name }} || echo "⚠️ Container not found!"
          
          echo "📋 Recent logs:"
          docker logs {{ app_name }} --tail 30 || echo "⚠️ Could not get logs"
          
          echo "✅ Deployment completed!"

