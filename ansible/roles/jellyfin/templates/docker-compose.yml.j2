---
services:
  jellyfin:
    image: {{ jellyfin_image }}
    container_name: {{ jellyfin_container_name }}
    restart: unless-stopped
    user: "{{ jellyfin_uid }}:{{ jellyfin_gid }}"
{% if jellyfin_hwaccel_enabled | bool and jellyfin_group_add | length > 0 %}
    group_add:
{% for gid in jellyfin_group_add %}
      - "{{ gid }}"
{% endfor %}
{% endif %}
    ports:
      - "{{ docker_publish_bind | default('127.0.0.1') }}:{{ jellyfin_external_port }}:{{ jellyfin_internal_port }}"
    environment:
      JELLYFIN_PublishedServerUrl: "{{ jellyfin_published_url }}"
      TZ: "Europe/Warsaw"
    volumes:
      - "{{ jellyfin_config_dir }}:/config"
      - "{{ jellyfin_cache_dir }}:/cache"
      - "{{ jellyfin_media_dir }}:/media{{ ':ro' if jellyfin_media_readonly | bool else '' }}"
{% if jellyfin_hwaccel_enabled | bool %}
    devices:
      - "{{ jellyfin_hwaccel_device }}:/dev/dri"
{% endif %}
    networks:
      - {{ jellyfin_network }}
    logging:
      driver: "json-file"
      options:
        max-file: "3"
        max-size: "50m"
    deploy:
      resources:
        limits:
          cpus: '{{ jellyfin_cpu_limit }}'
          memory: {{ jellyfin_memory_limit }}

networks:
  {{ jellyfin_network }}:
    name: {{ jellyfin_network }}
    external: true
